{
  "manifest_version": 3,
  "name": "VidDown Companion",
  "version": "2.9.0.1",
  "description": "Detects video pages and sends supported download requests to the VidDown desktop app.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "VidDown — send current tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "alarms",
    "contextMenus",
    "activeTab",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
